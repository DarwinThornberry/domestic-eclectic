# ─── Supabase ─────────────────────────────────────────────────────────────────
# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Find these in Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Resend (email) ───────────────────────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_...

# ─── Email addresses ──────────────────────────────────────────────────────────
PRINTER_EMAIL=printer@example.com
ADMIN_EMAIL=admin@example.com
# Comma-separated list of emails allowed to log in to the admin panel
ADMIN_EMAILS=admin@example.com

# ─── Site ─────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000

# ─── Launch mode ──────────────────────────────────────────────────────────────
# Set to 'true' to open checkout and hide the coming-soon banner/signup blocks
STORE_LIVE=false
